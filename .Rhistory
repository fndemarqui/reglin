library(survstan)
library(dplyr)
library(GGally)
ovarian <- ovarian %>%
mutate(
across(c("rx", "resid.ds"), as.factor)
)
ph <- phreg(
Surv(futime, fustat) ~ ecog.ps + rx,
dist = "weibull", data = ovarian
)
aft <- aftreg(
Surv(futime, fustat) ~ ecog.ps + rx,
dist = "weibull", data = ovarian
)
estimates(aft)
estimates(ph)
