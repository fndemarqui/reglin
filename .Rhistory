library(tidyverse)
library(tidymodels)
data("penguins")
glimpse(penguins)
pinguins <- penguins |>
drop_na()
glimpse(pinguins)
fit <- glm(sex ~ scpecies + body_mass_g + island, data = pinguins, family = "binomial")
fit <- glm(sex ~ species + body_mass_g + island, data = pinguins, family = "binomial")
ggresiduals(fit)
