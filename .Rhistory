setwd("~/Documents/UFMG/Ensino/EST079/provas/trabalho")
library(tidyverse)
library(pROC)
library(kknn)
# source: https://www.kaggle.com/c/titanic/data
titanic <- rio::import("titanic.csv")
glimpse(titanic)
titanic <- titanic |>
mutate(
vivo = ifelse(alive == "yes", 1, 0),
alive = as.factor(alive),
classe = recode(class,
"First" = "I",
"Second" = "II",
"Third" = "III"
),
classe = factor(classe, levels = c("III", "II", "I")),
idade = age,
sexo = sex
) |>
select(vivo, classe, idade, sexo, alive) |>
na.exclude()
glimpse(titanic)
fit <- glm(vivo ~ classe + idade, data = titanic, family = "binomial")
fam <- binomial(link = "cloglog")
fit <- glm(vivo ~ classe + idade + sexo, data = titanic, family = fam)
ggresiduals(fit, which = 2)
r <- qresiduals(fit)
shapiro.test(r)
r <- qresiduals(fit)
shapiro.test(r)
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
ggresiduals(fit, which = 2)
r <- qresiduals(fit)
shapiro.test(r)
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
ggresiduals(fit, which = 2)
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
ggresiduals(fit, which = 2)
r <- qresiduals(fit)
shapiro.test(r)
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
ggresiduals(fit, which = 2)
ggresiduals(fit)
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
devtools::load_all("~/Documents/UFMG/Ensino/pacotes/reglin")
ggresiduals(fit, which = 2)
ggresiduals(fit)
