library(tidyverse)
library(bellreg)
library(ggfortify)
library(reglin)
library(ggplot2)
n <- 500
beta <- c(0.5, -1, -1)
phi <- 0.5
simdata <- tibble(
x1 = rnorm(n),
x2 = rnorm(n),
x3 = sample(c("A", "B"), size = n, replace = TRUE),
x4 = rnorm(n),
m = rpois(n, lambda = 10),
#y = rglm(~ x1 + x2, beta = beta, family = "poisson"),
#lp = lp(~ x1 + x2, beta = beta),
#y = rglm(~ x1 + x2, beta = beta, family = inverse.gaussian(link = "log"), phi = phi)
# bell = rglm(~ x1 + x2, beta = c(0.5, 1, -1), family = bell(link = "log")),
y = rglm(~ x1 + x2, beta = c(0.5, 1, -1), family = binomial(link = "logit"), size = m),
)
fit <- glm(cbind(y, m - y) ~ x1 + x2, data = simdata, family = "binomial")
ggresiduals(fit)
ggresiduals(fit)
devtools::load_all(".")
ggresiduals(fit)
ggresiduals(fit)
devtools::load_all(".")
ggresiduals(fit)
fit <- glm(y ~ x1 + x2, data = simdata, family = poisson(link = "log"))
ggresiduals(fit)
fit <- glm(y ~ x1 + x2, data = simdata, family = bell(link = "log"))
ggresiduals(fit)
