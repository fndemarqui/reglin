library(tidyverse)
library(reglin)
set.seed(1234567890)
n <- 100
simdata <- data.frame(
x1 = rnorm(n),
x2 = rnorm(n),
x3 = exp(rnorm(n))
) |>
mutate(
y = simdata <- rlm(~ x1 + x2 + log(x3), beta = c(2.3, 0, 1.7, 1), sigma = 1)
)
glimpse(simdata)
# escala incorreda de x3:
fit <- lm(y ~ x1 + x2 + x3, data = simdata)
ggresiduals(fit, type = "default")
library(tidyverse)
library(reglin)
set.seed(1234567890)
n <- 100
simdata <- data.frame(
x1 = rnorm(n),
x2 = rnorm(n),
x3 = exp(rnorm(n))
) |>
mutate(
y = simdata <- rlm(~ x1 + x2 + log(x3), beta = c(2.3, 0, 1.7, 1), sigma = 1)
)
glimpse(simdata)
# escala incorreda de x3:
fit <- lm(y ~ x1 + x2 + x3, data = simdata)
ggresiduals(fit, type = "default")
object <- fit
which = 1:4
alpha <- 0.05
type.residuals <- "quantile"
if(type.residuals == "quantile"){
df <- broom::augment(object)
df$.std.resid <-  qresid(object)
}else{
df <- broom::augment(object, type.residuals = type.residuals)
}
