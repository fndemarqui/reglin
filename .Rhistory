library(MASS)     # banco de dados + glm.nb()
library(bellreg)  # dist. Bell
library(reglin)
library(tidyverse)
library(broom)
# carregando os dados:
data(ships)
glimpse(ships)
ships <- ships |>
mutate(
across(c(type, period, year), as.factor),
) |>
filter(service > 0)
# verificando a média e variância da contagem (indicativo inicial de dispersão):
mean(ships$incidents)
var(ships$incidents)
bell <- glm(
incidents ~ type + period + year + offset(log(service)),
family = bell(link = "log"),
data = ships
)
# verificando os resíduos do modelo ajustado:
ggresiduals(bell)
shapiro.test(qresiduals(bell))
# sumarizando o modelo:
summary(bell)
# Razões de taxas de incidência:
tidy(bell, conf.int = TRUE, exponentiate = TRUE)
