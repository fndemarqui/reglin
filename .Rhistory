library(MASS) # para o banco de dados
# carregando os dados:
data(ships)
glimpse(ships)
ships <- ships |>
mutate(
type = as.factor(type)
) |>
filter(service > 0)
# ajustando o modelo:
fit <- glm(
incidents ~ type + offset(log(service)),
family = poisson(link = "log"),
data = ships
)
# sumarizando o modelo:
summary(fit)
env <- envelope(fit, type = "pearson")
a <- reglin:::envelop(fit)
formula(fit)
